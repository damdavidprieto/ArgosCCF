# .gitignore for ArgosCCF PowerShell Module

# Logs
Logs/*.log
*.log
Logs/*.zip
Logs/*.old
*.old

# User configurations (keep Factory and Presets in repo)
Configs/User/*.json

# PowerShell Gallery build artifacts
*.nupkg
publish/

# Test results
TestResults/
*.trx

# IDE
.vscode/
.idea/
*.code-workspace

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
~$*
